Library.Unload = function(self)
    for _, c in self.Connections do pcall(function() c:Disconnect() end) end
    for _, t in self.Threads do pcall(function() coroutine.close(t) end) end
    if self.Holder then self.Holder:Destroy() end
    Library = nil
end

Library.NextFlag = function(self)
    return SFormat("flag_%s", HttpService:GenerateGUID(false))
end

Library.Thread = function(self, Function)
    local t = coroutine.create(Function)
    coroutine.wrap(function() coroutine.resume(t) end)()
    TIns(self.Threads, t)
    return t
end

Library.Connect = function(self, Event, Callback)
    local c = Event:Connect(Callback)
    TIns(self.Connections, c)
    return c
end

Library.SafeCall = function(self, Function, ...)
    local args = {...}
    local ok, res = pcall(Function, TUnpack(args))
    if not ok then warn("[Evasion] " .. tostring(res)) return false end
    return ok
end

Library.Round = function(self, Number, Float)
    local m = 1 / (Float or 1)
    return Floor(Number * m) / m
end

Library.GetLighterColor = function(self, Color, Inc)
    local h, s, v = Color:ToHSV()
    return FromHSV(h, s, Clamp(v * Inc, 0, 1))
end

Library.AddToTheme = function(self, Item, Properties)
    local td = {Item = Item, Properties = Properties}
    for p, v in td.Properties do
        if type(v) == "string" then Item[p] = self.Theme[v] else Item[p] = v() end
    end
    TIns(self.ThemeItems, td)
    self.ThemeMap[Item] = td
end

Library.ChangeItemTheme = function(self, Item, Properties)
    if not self.ThemeMap[Item] then return end
    self.ThemeMap[Item].Properties = Properties
end

Library.ChangeTheme = function(self, ThemeName, Color)
    self.Theme[ThemeName] = Color
    for _, item in self.ThemeItems do
        for p, v in item.Properties do
            if type(v) == "string" and v == ThemeName then item.Item[p] = Color
            elseif type(v) == "function" then item.Item[p] = v() end
        end
    end
end

local T = Library.Theme

local function Corner(p, r)
    local c=INew("UICorner"); c.CornerRadius=UD(0,r or 4); c.Parent=p; return c
end
local function Stroke(p, col, thick)
    local s=INew("UIStroke"); s.Color=col or T.Border; s.Thickness=thick or 1; s.Parent=p; return s
end
local function Pad(p, t, b, l, r)
    local pd=INew("UIPadding"); pd.PaddingTop=UD(0,t or 0); pd.PaddingBottom=UD(0,b or 0)
    pd.PaddingLeft=UD(0,l or 0); pd.PaddingRight=UD(0,r or 0); pd.Parent=p; return pd
end
local function List(p, dir, pad, ha, va)
    local l=INew("UIListLayout"); l.FillDirection=dir or Enum.FillDirection.Vertical
    l.Padding=UD(0,pad or 0); l.HorizontalAlignment=ha or Enum.HorizontalAlignment.Left
    l.VerticalAlignment=va or Enum.VerticalAlignment.Top; l.SortOrder=Enum.SortOrder.LayoutOrder
    l.Parent=p; return l
end
local function tw(obj, goal, t)
    TweenService:Create(obj, TweenInfo.new(t or Library.Tween.Time, Library.Tween.Style, Library.Tween.Direction), goal):Play()
end

