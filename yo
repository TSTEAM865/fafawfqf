-- Toggle
Library.Sections.Toggle = function(self, Data)
    Data = Data or {}
    local Toggle = {
        Window = self.Window,
        Page = self.Page,
        Section = self,
        Name = Data.Name or "Toggle",
        Flag = Data.Flag or Library:NextFlag(),
        Default = Data.Default or false,
        Callback = Data.Callback or function() end,
        Value = false
    }
    
    local row = INew("Frame")
    row.Parent = self.Items.Content
    row.BackgroundTransparency = 1
    row.BorderSizePixel = 0
    row.Size = U2(1, 0, 0, 20)
    
    local label = INew("TextLabel")
    label.Parent = row
    label.Text = Toggle.Name
    label.Font = Library.Font
    label.TextColor3 = T.TextMuted
    label.TextSize = 11
    label.BackgroundTransparency = 1
    label.BorderSizePixel = 0
    label.Position = U2(0, 0, 0.5, -6)
    label.Size = U2(0, 100, 0, 12)
    label.TextXAlignment = Enum.TextXAlignment.Left
    
    -- Toggle Switch
    local toggle = INew("Frame")
    toggle.Parent = row
    toggle.BackgroundColor3 = T.Surface3
    toggle.BorderSizePixel = 0
    toggle.Position = U2(1, -44, 0.5, -8)
    toggle.Size = U2(0, 40, 0, 16)
    toggle.AnchorPoint = V2(1, 0.5)
    Corner(toggle, 99)
    Stroke(toggle, T.Border, 1)
    
    local thumb = INew("Frame")
    thumb.Parent = toggle
    thumb.BackgroundColor3 = T.TextMuted
    thumb.BorderSizePixel = 0
    thumb.Position = U2(0, 2, 0.5, -4)
    thumb.Size = U2(0, 8, 0, 8)
    Corner(thumb, 99)
    
    local function Update(Value)
        Toggle.Value = Value
        Library.Flags[Toggle.Flag] = Value
        
        if Value then
            Tween(toggle, {BackgroundColor3 = T.AccentDim}, 0.15)
            Tween(thumb, {Position = U2(1, -10, 0.5, -4), BackgroundColor3 = T.Accent}, 0.2)
            label.TextColor3 = T.Text
        else
            Tween(toggle, {BackgroundColor3 = T.Surface3}, 0.15)
            Tween(thumb, {Position = U2(0, 2, 0.5, -4), BackgroundColor3 = T.TextMuted}, 0.2)
            label.TextColor3 = T.TextMuted
        end
        
        Library:SafeCall(Toggle.Callback, Value)
    end
    
    row.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Update(not Toggle.Value)
        end
    end)
    
    Update(Toggle.Default)
    Library.SetFlags[Toggle.Flag] = function(v) Update(v) end
    
    return Toggle
end

-- Slider
Library.Sections.Slider = function(self, Data)
    Data = Data or {}
    local Slider = {
        Window = self.Window,
        Page = self.Page,
        Section = self,
        Name = Data.Name or "Slider",
        Flag = Data.Flag or Library:NextFlag(),
        Min = Data.Min or 0,
        Max = Data.Max or 100,
        Default = Data.Default or 0,
        Decimals = Data.Decimals or 0,
        Suffix = Data.Suffix or "",
        Callback = Data.Callback or function() end,
        Value = 0,
        Sliding = false
    }
    
    local container = INew("Frame")
    container.Parent = self.Items.Content
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.Size = U2(1, 0, 0, 32)
    
    local label = INew("TextLabel")
    label.Parent = container
    label.Text = Slider.Name
    label.Font = Library.Font
    label.TextColor3 = T.TextMuted
    label.TextSize = 11
    label.BackgroundTransparency = 1
    label.BorderSizePixel = 0
    label.Size = U2(0.6, 0, 0, 12)
    label.TextXAlignment = Enum.TextXAlignment.Left
    
    local valueLabel = INew("TextLabel")
    valueLabel.Parent = container
    valueLabel.Font = Library.Font
    valueLabel.TextColor3 = T.Accent
    valueLabel.TextSize = 11
    valueLabel.BackgroundTransparency = 1
    valueLabel.BorderSizePixel = 0
    valueLabel.Position = U2(1, 0, 0, 0)
    valueLabel.AnchorPoint = V2(1, 0)
    valueLabel.Text = tostring(Slider.Default) .. Slider.Suffix
    valueLabel.Size = U2(0.4, 0, 0, 12)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    
    local track = INew("Frame")
    track.Parent = container
    track.BackgroundColor3 = T.Surface3
    track.BorderSizePixel = 0
    track.Position = U2(0, 0, 0, 18)
    track.Size = U2(1, 0, 0, 6)
    track.ClipsDescendants = true
    Corner(track, 99)
    Stroke(track, T.Border, 1)
    
    local fill = INew("Frame")
    fill.Parent = track
    fill.BackgroundColor3 = T.Accent
    fill.BorderSizePixel = 0
    fill.Position = U2(0, 0, 0, 0)
    fill.Size = U2(0, 0, 1, 0)
    
    local function Update(Value)
        Slider.Value = Clamp(Library:Round(Value, Slider.Decimals), Slider.Min, Slider.Max)
        Library.Flags[Slider.Flag] = Slider.Value
        
        local pct = (Slider.Value - Slider.Min) / (Slider.Max - Slider.Min)
        fill.Size = U2(pct, 0, 1, 0)
        valueLabel.Text = tostring(Slider.Value) .. Slider.Suffix
        
        Library:SafeCall(Slider.Callback, Slider.Value)
    end
    
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Slider.Sliding = true
            local pos = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
            Update((Slider.Max - Slider.Min) * pos + Slider.Min)
        end
    end)
    
    track.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Slider.Sliding = false
        end
    end)
    
    Library:Connect(UserInputService.InputChanged, function(input)
        if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and Slider.Sliding then
            local pos = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
            Update((Slider.Max - Slider.Min) * Clamp(pos, 0, 1) + Slider.Min)
        end
    end)
    
    Update(Slider.Default)
    Library.SetFlags[Slider.Flag] = function(v) Update(v) end
    
    return Slider
end

