    local Keys={Backspace="Back",Tab="Tab",Return="Enter",Escape="Esc",Space="Space",Delete="Del",End="End",Home="Home",PageUp="PgUp",PageDown="PgDn",RightShift="RShift",LeftShift="LShift",RightControl="RCtrl",LeftControl="LCtrl",LeftAlt="LAlt",RightAlt="RAlt",Insert="Ins"}
    function Keybind:Set(Key)
        if SFind(tostring(Key),"Enum") then
            Keybind.Key=tostring(Key); local kname=Key.Name=="Backspace" and "None" or Key.Name
            local ks=Keys[Keybind.Key] or SGSub(kname,"Enum.","") or "None"
            local td=SGSub(SGSub(ks,"KeyCode.",""),"UserInputType.","")
            Keybind.Value=td; Items["KeyButton"].Instance.Text="[ "..td.." ]"
            Library.Flags[Keybind.Flag]={Mode=Keybind.Mode,Key=Keybind.Key,Toggled=Keybind.Toggled,active=Keybind.Toggled}
            if Data.Callback then Library:SafeCall(Data.Callback,Keybind.Toggled) end; Update()
        elseif type(Key)=="table" then
            local rk=Key.Key=="Backspace" and "None" or Key.Key; Keybind.Key=tostring(Key.Key)
            Keybind.Mode=Key.Mode or "Toggle"; Keybind:SetMode(Keybind.Mode)
            local ks=Keys[Keybind.Key] or SGSub(tostring(rk),"Enum.","") or rk
            local td=SGSub(SGSub(ks,"KeyCode.",""),"UserInputType.","")
            Keybind.Value=td; Items["KeyButton"].Instance.Text="[ "..td.." ]"
            if Key.Toggled then Keybind:Press(Key.Toggled,true) end
            if Data.Callback then Library:SafeCall(Data.Callback,Keybind.Toggled) end; Update()
        elseif TFind({"Toggle","Hold","Always"},Key) then
            Keybind.Mode=Key; Keybind:SetMode(Keybind.Mode)
            if Data.Callback then Library:SafeCall(Data.Callback,Keybind.Toggled) end; Update()
        elseif type(Key)=="boolean" then Keybind:Press(Key) end
        Keybind.Picking=false
    end
    function Keybind:Press(Bool)
        if Keybind.Mode=="Toggle" then Keybind.Toggled=not Keybind.Toggled
        elseif Keybind.Mode=="Hold" then Keybind.Toggled=Bool
        elseif Keybind.Mode=="Always" then Keybind.Toggled=true end
        Library.Flags[Keybind.Flag]={Mode=Keybind.Mode,Key=Keybind.Key,Toggled=Keybind.Toggled,active=Keybind.Toggled}
        if Data.Callback then Library:SafeCall(Data.Callback,Keybind.Toggled) end; Update()
    end
    function Keybind:SetMode(Mode)
        for idx,v in Modes do
            if idx==Mode then v[1]:Tween(nil,{BackgroundTransparency=0}); v[2]:Tween(nil,{BackgroundTransparency=0})
            else v[1]:Tween(nil,{BackgroundTransparency=1}); v[2]:Tween(nil,{BackgroundTransparency=1}) end
        end
        Library.Flags[Keybind.Flag]={Mode=Keybind.Mode,Key=Keybind.Key,Toggled=Keybind.Toggled,active=Keybind.Toggled}
        if Data.Callback then Library:SafeCall(Data.Callback,Keybind.Toggled) end; Update()
    end
    Items["KeyButton"]:Connect("MouseButton1Click",function()
        Keybind.Picking=true; Items["KeyButton"].Instance.Text="[ ... ]"
        Library:Thread(function()
            local n=1
            while Keybind.Picking do
                Items["KeyButton"].Instance.Text=n==1 and "[ . ]" or n==2 and "[ .. ]" or "[ ... ]"
                n=n%3+1; task.wait(0.35)
            end
        end)
        local ib
        ib=UserInputService.InputBegan:Connect(function(Input)
            if Input.UserInputType==Enum.UserInputType.Keyboard then Keybind:Set(Input.KeyCode)
            elseif Input.UserInputType==Enum.UserInputType.Touch then
                Keybind.Picking=false; Items["KeyButton"].Instance.Text="[ Touch ]"
                Keybind.Key="Touch"; Keybind.Value="Touch"
                Library.Flags[Keybind.Flag]={Mode=Keybind.Mode,Key="Touch",Toggled=Keybind.Toggled,active=Keybind.Toggled}
            else Keybind:Set(Input.UserInputType) end
            if ib then ib:Disconnect(); ib=nil end
        end)
    end)
    if IsMobile then MakeLongPress(Items["KeyButton"].Instance,function() Keybind:SetOpen(not Keybind.IsOpen) end)
    else Items["KeyButton"]:Connect("MouseButton2Down",function() Keybind:SetOpen(not Keybind.IsOpen) end) end
    Library:Connect(UserInputService.InputBegan,function(Input)
        if Keybind.Value~="None" and Keybind.Value~="" then
            if tostring(Input.KeyCode)==Keybind.Key or tostring(Input.UserInputType)==Keybind.Key then
                if Keybind.Mode=="Toggle" then Keybind:Press()
                elseif Keybind.Mode=="Hold" then Keybind:Press(true)
                elseif Keybind.Mode=="Always" then Keybind:Press(true) end
            end
        end
        if Input.UserInputType==Enum.UserInputType.MouseButton1 or Input.UserInputType==Enum.UserInputType.Touch then
            task.defer(function()
                if not Keybind.IsOpen then return end
                if Library:IsMouseOverFrame(Items["KeybindWindow"]) then return end
                Keybind:SetOpen(false)
            end)
        end
    end)
    Library:Connect(UserInputService.InputEnded,function(Input)
        if Keybind.Value~="None" and Keybind.Value~="" then
            if tostring(Input.KeyCode)==Keybind.Key or tostring(Input.UserInputType)==Keybind.Key then
                if Keybind.Mode=="Hold" then Keybind:Press(false)
                elseif Keybind.Mode=="Always" then Keybind:Press(true) end
            end
        end
    end)
    ToggleBtn:Connect("MouseButton1Down",function() Keybind.Mode="Toggle"; Keybind:SetMode("Toggle") end)
    HoldBtn:Connect("MouseButton1Down",function() Keybind.Mode="Hold"; Keybind:SetMode("Hold") end)
    AlwaysBtn:Connect("MouseButton1Down",function() Keybind.Mode="Always"; Keybind:SetMode("Always On") end)
    if Data.Default then Keybind:Set({Key=Data.Default,Mode=Data.Mode or "Toggle",Toggled=Data.Toggled}) end
    Library.SetFlags[Keybind.Flag]=function(v) Keybind:Set(v) end
    return Keybind,Items
end

