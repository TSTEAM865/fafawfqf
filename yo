Library.Page = function(self, Data)
    Data = Data or {}
    local Page = {
        Window = self,
        Name = Data.Name or "Page",
        Items = {},
        Active = false
    }
    
    -- Create nav button
    local navBtn = INew("TextButton")
    navBtn.Parent = self.NavContainer
    navBtn.Text = Page.Name:sub(1, 8)
    navBtn.Font = Library.Fonts["Gotham"]
    navBtn.TextColor3 = T.TextMuted
    navBtn.TextSize = 11
    navBtn.BackgroundColor3 = T.Surface
    navBtn.BorderSizePixel = 0
    navBtn.Size = U2(1, -4, 0, 32)
    navBtn.TextScaled = true
    navBtn.ClipsDescendants = true
    Corner(navBtn, 4)
    Stroke(navBtn, T.Border, 1)
    
    -- Page content container
    local pageContainer = INew("Frame")
    pageContainer.Parent = self.Content
    pageContainer.Name = Page.Name
    pageContainer.BackgroundTransparency = 1
    pageContainer.Size = U2(1, 0, 0, 0)
    pageContainer.BorderSizePixel = 0
    pageContainer.AutomaticSize = Enum.AutomaticSize.Y
    
    Page.Items.Button = navBtn
    Page.Items.Container = pageContainer
    
    local function SetActive(bool)
        Page.Active = bool
        if bool then
            navBtn.BackgroundColor3 = T.Accent
            navBtn.TextColor3 = T.Text
        else
            navBtn.BackgroundColor3 = T.Surface
            navBtn.TextColor3 = T.TextMuted
        end
    end
    
    navBtn.MouseButton1Click:Connect(function()
        for _, p in self.Pages do
            SetActive(p == Page)
            if p ~= Page then
                p.Items.Button.BackgroundColor3 = T.Surface
                p.Items.Button.TextColor3 = T.TextMuted
            end
        end
    end)
    
    TIns(self.Pages, Page)
    
    -- Auto-activate first page
    if #self.Pages == 1 then SetActive(true) end
    
    return setmetatable(Page, Library.Pages)
end

